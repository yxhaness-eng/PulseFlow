{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "./index.html",
  "name": "PulseFlow — Личная Продуктивность & Трекер",
  "short_name": "PulseFlow",
  "description": "Прогрессивное веб-приложение для трекинга здоровья, тренировок, ежедневника и умного досуга.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "categories": [
    "productivity",
    "health",
    "fitness",
    "lifestyle"
  ],
  "shortcuts": [
    {
      "name": "Записать воду",
      "short_name": "Вода",
      "description": "Быстрая отметка выпитого стакана воды",
      "url": "./index.html#water",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Начать тренировку",
      "short_name": "Тренировка",
      "description": "Дневник тренировок и активный таймер",
      "url": "./index.html#workouts",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ежедневник",
      "short_name": "Дневник",
      "description": "Заметки и трекер привычек на сегодня",
      "url": "./index.html#diary",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
